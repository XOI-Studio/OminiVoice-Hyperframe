# Copy to .env (git-ignored) and fill in. Used by both services via `docker run --env-file ../.env`.
S3_BUCKET=
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public URL of the bucket (CDN domain, R2 public URL...). Empty = AWS-style https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_BASE_URL=
# Only for S3-compatible storage other than AWS, e.g. https://<account>.r2.cloudflarestorage.com (then AWS_REGION=auto)
S3_ENDPOINT_URL=

# Optional. Empty = open API, no key needed. When set, clients send it as the X-API-Key header.
API_KEY=
